{
	"name": "bun-release",
	"version": "0.0.0",
	"description": "OIDC bun-publish helpers for public npm.",
	"license": "MIT",
	"author": {
		"name": "Victor Araújo",
		"email": "victor@victor-software-house.com"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"prepublishOnly": "mise run verify"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "bun@1.4.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26"
		},
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.0 <2.0.0"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/victor-software-house/bun-release.git"
	},
	"homepage": "https://github.com/victor-software-house/bun-release#readme",
	"bugs": {
		"url": "https://github.com/victor-software-house/bun-release/issues"
	},
	"keywords": [
		"bun",
		"npm",
		"oidc",
		"publish",
		"changesets"
	],
	"dependencies": {
		"p-retry": "8.0.0",
		"ts-pattern": "5.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@changesets/cli": "3.0.1",
		"@changesets/get-github-info": "1.0.0",
		"@changesets/types": "7.0.0",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@limegrass/eslint-plugin-import-alias": "1.6.1",
		"@types/bun": "1.4.0",
		"@types/node": "26.4.0",
		"@victor-software-house/anti-slop": "0.0.1",
		"bun-release": ".",
		"dedent": "1.7.2",
		"knip": "6.33.0",
		"liquidjs": "10.29.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"tsdown": "0.22.14",
		"typescript": "7.0.2"
	}
}
